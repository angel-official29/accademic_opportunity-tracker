digraph ER { graph [rankdir=LR,bgcolor="white",pad=0.3,nodesep=0.55,ranksep=1.4,splines=spline,label="Academic Opportunity Tracker relationships",labelloc=t,fontname="Arial",fontsize=22]; node [shape=plain,fontname="Arial"]; edge [color="#597480",fontname="Arial",fontsize=10,arrowsize=0.5];
"student_profiles" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8A9FA8"><TR><TD COLSPAN="2" BGCOLOR="#17394A"><FONT COLOR="white"><B>student_profiles</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">PK</FONT></TD><TD PORT="student_id" ALIGN="LEFT">student_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">UQ FK</FONT></TD><TD PORT="user_id" ALIGN="LEFT">user_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">UQ</FONT></TD><TD PORT="university_uid" ALIGN="LEFT">university_uid</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">FK</FONT></TD><TD PORT="department_id" ALIGN="LEFT">department_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60"></FONT></TD><TD PORT="current_year" ALIGN="LEFT">current_year</TD></TR></TABLE>>];
"opportunities" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8A9FA8"><TR><TD COLSPAN="2" BGCOLOR="#17394A"><FONT COLOR="white"><B>opportunities</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">PK</FONT></TD><TD PORT="opportunity_id" ALIGN="LEFT">opportunity_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">FK</FONT></TD><TD PORT="organization_id" ALIGN="LEFT">organization_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">FK</FONT></TD><TD PORT="category_id" ALIGN="LEFT">category_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60"></FONT></TD><TD PORT="title" ALIGN="LEFT">title</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60"></FONT></TD><TD PORT="listing_status" ALIGN="LEFT">listing_status</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">FK</FONT></TD><TD PORT="created_by" ALIGN="LEFT">created_by</TD></TR></TABLE>>];
"applications" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8A9FA8"><TR><TD COLSPAN="2" BGCOLOR="#17394A"><FONT COLOR="white"><B>applications</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">PK</FONT></TD><TD PORT="application_id" ALIGN="LEFT">application_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">FK</FONT></TD><TD PORT="student_id" ALIGN="LEFT">student_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">FK</FONT></TD><TD PORT="opportunity_id" ALIGN="LEFT">opportunity_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60"></FONT></TD><TD PORT="application_status" ALIGN="LEFT">application_status</TD></TR></TABLE>>];
"application_status_history" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8A9FA8"><TR><TD COLSPAN="2" BGCOLOR="#17394A"><FONT COLOR="white"><B>application_status_history</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">PK</FONT></TD><TD PORT="history_id" ALIGN="LEFT">history_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">FK</FONT></TD><TD PORT="application_id" ALIGN="LEFT">application_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">FK</FONT></TD><TD PORT="changed_by" ALIGN="LEFT">changed_by</TD></TR></TABLE>>];
"users" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8A9FA8"><TR><TD COLSPAN="2" BGCOLOR="#17394A"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">PK</FONT></TD><TD PORT="user_id" ALIGN="LEFT">user_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60"></FONT></TD><TD PORT="full_name" ALIGN="LEFT">full_name</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">UQ</FONT></TD><TD PORT="email" ALIGN="LEFT">email</TD></TR></TABLE>>];
"application_documents" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8A9FA8"><TR><TD COLSPAN="2" BGCOLOR="#17394A"><FONT COLOR="white"><B>application_documents</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">PK FK</FONT></TD><TD PORT="application_id" ALIGN="LEFT">application_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">PK FK</FONT></TD><TD PORT="document_type_id" ALIGN="LEFT">document_type_id</TD></TR></TABLE>>];
"document_types" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8A9FA8"><TR><TD COLSPAN="2" BGCOLOR="#17394A"><FONT COLOR="white"><B>document_types</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">PK</FONT></TD><TD PORT="document_type_id" ALIGN="LEFT">document_type_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">UQ</FONT></TD><TD PORT="document_name" ALIGN="LEFT">document_name</TD></TR></TABLE>>];
"preparation_tasks" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8A9FA8"><TR><TD COLSPAN="2" BGCOLOR="#17394A"><FONT COLOR="white"><B>preparation_tasks</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">PK</FONT></TD><TD PORT="task_id" ALIGN="LEFT">task_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">FK</FONT></TD><TD PORT="application_id" ALIGN="LEFT">application_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60"></FONT></TD><TD PORT="task_title" ALIGN="LEFT">task_title</TD></TR></TABLE>>];
"notifications" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8A9FA8"><TR><TD COLSPAN="2" BGCOLOR="#17394A"><FONT COLOR="white"><B>notifications</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">PK</FONT></TD><TD PORT="notification_id" ALIGN="LEFT">notification_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">FK</FONT></TD><TD PORT="user_id" ALIGN="LEFT">user_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60"></FONT></TD><TD PORT="title" ALIGN="LEFT">title</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">FK</FONT></TD><TD PORT="opportunity_id" ALIGN="LEFT">opportunity_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">FK</FONT></TD><TD PORT="application_id" ALIGN="LEFT">application_id</TD></TR></TABLE>>];
"applications" -> "application_documents" [taillabel="1",headlabel="0..N",label="application_id",labeldistance=2,arrowhead=none];
"document_types" -> "application_documents" [taillabel="1",headlabel="0..N",label="document_type_id",labeldistance=2,arrowhead=none];
"applications" -> "application_status_history" [taillabel="1",headlabel="0..N",label="application_id",labeldistance=2,arrowhead=none];
"users" -> "application_status_history" [taillabel="1",headlabel="0..N",label="changed_by",labeldistance=2,arrowhead=none];
"opportunities" -> "applications" [taillabel="1",headlabel="0..N",label="opportunity_id",labeldistance=2,arrowhead=none];
"student_profiles" -> "applications" [taillabel="1",headlabel="0..N",label="student_id",labeldistance=2,arrowhead=none];
"applications" -> "notifications" [taillabel="0..1",headlabel="0..N",label="application_id",labeldistance=2,arrowhead=none];
"opportunities" -> "notifications" [taillabel="0..1",headlabel="0..N",label="opportunity_id",labeldistance=2,arrowhead=none];
"users" -> "notifications" [taillabel="1",headlabel="0..N",label="user_id",labeldistance=2,arrowhead=none];
"users" -> "opportunities" [taillabel="1",headlabel="0..N",label="created_by",labeldistance=2,arrowhead=none];
"applications" -> "preparation_tasks" [taillabel="1",headlabel="0..N",label="application_id",labeldistance=2,arrowhead=none];
"users" -> "student_profiles" [taillabel="1",headlabel="0..1",label="user_id",labeldistance=2,arrowhead=none];
}