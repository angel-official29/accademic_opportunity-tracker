digraph ER { graph [rankdir=LR,bgcolor="white",pad=0.3,nodesep=0.55,ranksep=1.4,splines=spline,label="Complete Academic Opportunity Tracker schema",labelloc=t,fontname="Arial",fontsize=22]; node [shape=plain,fontname="Arial"]; edge [color="#597480",fontname="Arial",fontsize=10,arrowsize=0.5];
