"document_types" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8A9FA8"><TR><TD COLSPAN="2" BGCOLOR="#17394A"><FONT COLOR="white"><B>document_types</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">PK</FONT></TD><TD PORT="document_type_id" ALIGN="LEFT">document_type_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">UQ</FONT></TD><TD PORT="document_name" ALIGN="LEFT">document_name</TD></TR></TABLE>>];
"opportunity_documents" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8A9FA8"><TR><TD COLSPAN="2" BGCOLOR="#17394A"><FONT COLOR="white"><B>opportunity_documents</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">PK FK</FONT></TD><TD PORT="opportunity_id" ALIGN="LEFT">opportunity_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">PK FK</FONT></TD><TD PORT="document_type_id" ALIGN="LEFT">document_type_id</TD></TR></TABLE>>];
"opportunities" -> "eligibility_requirements" [taillabel="1",headlabel="0..1",label="opportunity_id",labeldistance=2,arrowhead=none];
"opportunity_categories" -> "opportunities" [taillabel="1",headlabel="0..N",label="category_id",labeldistance=2,arrowhead=none];
"users" -> "opportunities" [taillabel="1",headlabel="0..N",label="created_by",labeldistance=2,arrowhead=none];
