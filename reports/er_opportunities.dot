"skills" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8A9FA8"><TR><TD COLSPAN="2" BGCOLOR="#17394A"><FONT COLOR="white"><B>skills</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">PK</FONT></TD><TD PORT="skill_id" ALIGN="LEFT">skill_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">UQ</FONT></TD><TD PORT="skill_name" ALIGN="LEFT">skill_name</TD></TR></TABLE>>];
