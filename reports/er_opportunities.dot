"document_types" -> "opportunity_documents" [taillabel="1",headlabel="0..N",label="document_type_id",labeldistance=2,arrowhead=none];
"opportunities" -> "opportunity_documents" [taillabel="1",headlabel="0..N",label="opportunity_id",labeldistance=2,arrowhead=none];
"opportunities" -> "opportunity_skills" [taillabel="1",headlabel="0..N",label="opportunity_id",labeldistance=2,arrowhead=none];
"skills" -> "opportunity_skills" [taillabel="1",headlabel="0..N",label="skill_id",labeldistance=2,arrowhead=none];
