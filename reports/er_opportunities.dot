digraph ER { graph [rankdir=LR,bgcolor="white",pad=0.3,nodesep=0.55,ranksep=1.4,splines=spline,label="Academic Opportunity Tracker relationships",labelloc=t,fontname="Arial",fontsize=22]; node [shape=plain,fontname="Arial"]; edge [color="#597480",fontname="Arial",fontsize=10,arrowsize=0.5];
"organizations" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8A9FA8"><TR><TD COLSPAN="2" BGCOLOR="#17394A"><FONT COLOR="white"><B>organizations</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">PK</FONT></TD><TD PORT="organization_id" ALIGN="LEFT">organization_id</TD></TR></TABLE>>];
"opportunity_categories" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8A9FA8"><TR><TD COLSPAN="2" BGCOLOR="#17394A"><FONT COLOR="white"><B>opportunity_categories</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">PK</FONT></TD><TD PORT="category_id" ALIGN="LEFT">category_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">UQ</FONT></TD><TD PORT="category_name" ALIGN="LEFT">category_name</TD></TR></TABLE>>];
"users" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8A9FA8"><TR><TD COLSPAN="2" BGCOLOR="#17394A"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">PK</FONT></TD><TD PORT="user_id" ALIGN="LEFT">user_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60"></FONT></TD><TD PORT="full_name" ALIGN="LEFT">full_name</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">UQ</FONT></TD><TD PORT="email" ALIGN="LEFT">email</TD></TR></TABLE>>];
"opportunities" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8A9FA8"><TR><TD COLSPAN="2" BGCOLOR="#17394A"><FONT COLOR="white"><B>opportunities</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">PK</FONT></TD><TD PORT="opportunity_id" ALIGN="LEFT">opportunity_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">FK</FONT></TD><TD PORT="organization_id" ALIGN="LEFT">organization_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">FK</FONT></TD><TD PORT="category_id" ALIGN="LEFT">category_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60"></FONT></TD><TD PORT="title" ALIGN="LEFT">title</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60"></FONT></TD><TD PORT="listing_status" ALIGN="LEFT">listing_status</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">FK</FONT></TD><TD PORT="created_by" ALIGN="LEFT">created_by</TD></TR></TABLE>>];
"eligibility_requirements" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8A9FA8"><TR><TD COLSPAN="2" BGCOLOR="#17394A"><FONT COLOR="white"><B>eligibility_requirements</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">PK FK</FONT></TD><TD PORT="opportunity_id" ALIGN="LEFT">opportunity_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60"></FONT></TD><TD PORT="minimum_cgpa" ALIGN="LEFT">minimum_cgpa</TD></TR></TABLE>>];
"departments" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8A9FA8"><TR><TD COLSPAN="2" BGCOLOR="#17394A"><FONT COLOR="white"><B>departments</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">PK</FONT></TD><TD PORT="department_id" ALIGN="LEFT">department_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">UQ</FONT></TD><TD PORT="department_name" ALIGN="LEFT">department_name</TD></TR></TABLE>>];
