digraph ER { graph [rankdir=LR,bgcolor="white",pad=0.3,nodesep=0.55,ranksep=1.4,splines=spline,label="Academic Opportunity Tracker relationships",labelloc=t,fontname="Arial",fontsize=22]; node [shape=plain,fontname="Arial"]; edge [color="#597480",fontname="Arial",fontsize=10,arrowsize=0.5];
"users" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8A9FA8"><TR><TD COLSPAN="2" BGCOLOR="#17394A"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">PK</FONT></TD><TD PORT="user_id" ALIGN="LEFT">user_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60"></FONT></TD><TD PORT="full_name" ALIGN="LEFT">full_name</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">UQ</FONT></TD><TD PORT="email" ALIGN="LEFT">email</TD></TR></TABLE>>];
"student_profiles" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8A9FA8"><TR><TD COLSPAN="2" BGCOLOR="#17394A"><FONT COLOR="white"><B>student_profiles</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">PK</FONT></TD><TD PORT="student_id" ALIGN="LEFT">student_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">UQ FK</FONT></TD><TD PORT="user_id" ALIGN="LEFT">user_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">UQ</FONT></TD><TD PORT="university_uid" ALIGN="LEFT">university_uid</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">FK</FONT></TD><TD PORT="department_id" ALIGN="LEFT">department_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60"></FONT></TD><TD PORT="current_year" ALIGN="LEFT">current_year</TD></TR></TABLE>>];
"departments" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8A9FA8"><TR><TD COLSPAN="2" BGCOLOR="#17394A"><FONT COLOR="white"><B>departments</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">PK</FONT></TD><TD PORT="department_id" ALIGN="LEFT">department_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">UQ</FONT></TD><TD PORT="department_name" ALIGN="LEFT">department_name</TD></TR></TABLE>>];
"skills" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8A9FA8"><TR><TD COLSPAN="2" BGCOLOR="#17394A"><FONT COLOR="white"><B>skills</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">PK</FONT></TD><TD PORT="skill_id" ALIGN="LEFT">skill_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">UQ</FONT></TD><TD PORT="skill_name" ALIGN="LEFT">skill_name</TD></TR></TABLE>>];
"student_skills" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8A9FA8"><TR><TD COLSPAN="2" BGCOLOR="#17394A"><FONT COLOR="white"><B>student_skills</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">PK FK</FONT></TD><TD PORT="student_id" ALIGN="LEFT">student_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">PK FK</FONT></TD><TD PORT="skill_id" ALIGN="LEFT">skill_id</TD></TR></TABLE>>];
"student_interests" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8A9FA8"><TR><TD COLSPAN="2" BGCOLOR="#17394A"><FONT COLOR="white"><B>student_interests</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">PK FK</FONT></TD><TD PORT="student_id" ALIGN="LEFT">student_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">PK FK</FONT></TD><TD PORT="category_id" ALIGN="LEFT">category_id</TD></TR></TABLE>>];
"opportunity_categories" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8A9FA8"><TR><TD COLSPAN="2" BGCOLOR="#17394A"><FONT COLOR="white"><B>opportunity_categories</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">PK</FONT></TD><TD PORT="category_id" ALIGN="LEFT">category_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">UQ</FONT></TD><TD PORT="category_name" ALIGN="LEFT">category_name</TD></TR></TABLE>>];
"auth_sessions" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8A9FA8"><TR><TD COLSPAN="2" BGCOLOR="#17394A"><FONT COLOR="white"><B>auth_sessions</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">PK</FONT></TD><TD PORT="session_hash" ALIGN="LEFT">session_hash</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#126C60">FK</FONT></TD><TD PORT="user_id" ALIGN="LEFT">user_id</TD></TR></TABLE>>];
"users" -> "auth_sessions" [taillabel="1",headlabel="0..N",label="user_id",labeldistance=2,arrowhead=none];
"opportunity_categories" -> "student_interests" [taillabel="1",headlabel="0..N",label="category_id",labeldistance=2,arrowhead=none];
"student_profiles" -> "student_interests" [taillabel="1",headlabel="0..N",label="student_id",labeldistance=2,arrowhead=none];
"departments" -> "student_profiles" [taillabel="1",headlabel="0..N",label="department_id",labeldistance=2,arrowhead=none];
"users" -> "student_profiles" [taillabel="1",headlabel="0..1",label="user_id",labeldistance=2,arrowhead=none];
"skills" -> "student_skills" [taillabel="1",headlabel="0..N",label="skill_id",labeldistance=2,arrowhead=none];
"student_profiles" -> "student_skills" [taillabel="1",headlabel="0..N",label="student_id",labeldistance=2,arrowhead=none];
}